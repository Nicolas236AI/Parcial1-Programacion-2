<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox spacing="20" style="-fx-background-color: #040607; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.ViewController.ClienteViewController">
    <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px; -fx-pref-width: 320px;" spacing="12">
        <Label text="Administración de Clientes" style="-fx-text-fill: #BF40FA; -fx-font-size: 18px; -fx-font-weight: bold;" />

        <TextField fx:id="txtDocumento" promptText="Documento de Identidad" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField fx:id="txtNombre" promptText="Nombre Completo" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField fx:id="txtTelefono" promptText="Teléfono" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField fx:id="txtCorreo" promptText="Correo Electrónico" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField fx:id="txtEdad" promptText="Edad" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />

        <Region VBox.vgrow="ALWAYS" />
        <HBox spacing="10" alignment="CENTER">
            <Button text="Registrar" onAction="#onRegistrarCliente" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand;" />
            <Button text="Modificar" onAction="#onModificarCliente" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand;" />
            <Button text="Eliminar" onAction="#onEliminarCliente" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand;" />
        </HBox>
    </VBox>

    <VBox style="-fx-background-color: #040607;" spacing="12" HBox.hgrow="ALWAYS">
        <TableView fx:id="tableClientes" style="-fx-background-color: #040607; -fx-table-cell-border-color: #5B2A62;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDocumento" text="Documento" prefWidth="110" />
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="140" />
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100" />
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="140" />
                <TableColumn fx:id="colEdad" text="Edad" prefWidth="60" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>