<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane style="-fx-background-color: #040607;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-pref-width: 250px;" spacing="15">
            <Label text="SmartGym" style="-fx-text-fill: #BF40FA; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" />
            <Label text="Panel de Control" style="-fx-text-fill: #E3D9FC; -fx-font-size: 12px; -fx-opacity: 0.8;" />
            <Separator style="-fx-background-color: #4928C2;" />
            <Button text=" Dashboard" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Gestión de Clientes" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-font-weight: bold; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-background-radius: 8px;" />
            <Button text=" Entrenadores" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Planes" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Servicios Adicionales" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Inscripciones" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Reportes y Consultas" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Region VBox.vgrow="ALWAYS" />
            <Label text="NIT: 900.123.456-7&#10;Armenia, Quindío" style="-fx-text-fill: #E3D9FC; -fx-font-size: 10px; -fx-opacity: 0.6;" />
        </VBox>
    </left>
    <center>
        <HBox spacing="20" style="-fx-background-color: #040607; -fx-padding: 20px;">
            <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px; -fx-pref-width: 320px;" spacing="12">
                <Label text="Administración de Clientes" style="-fx-text-fill: #BF40FA; -fx-font-size: 18px; -fx-font-weight: bold;" />
                <TextField promptText="Nombre Completo" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
                <TextField promptText="Documento de Identidad" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
                <TextField promptText="Teléfono" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
                <TextField promptText="Correo Electrónico" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
                <TextField promptText="Edad" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
                <DatePicker promptText="Fecha de Registro" style="-fx-pref-width: Infinity;" />
                <Region VBox.vgrow="ALWAYS" />
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Registrar" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand;" />
                    <Button text="Modificar" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand;" />
                    <Button text="Eliminar" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand;" />
                </HBox>
            </VBox>
            <VBox style="-fx-background-color: #040607;" spacing="12" HBox.hgrow="ALWAYS">
                <TextField promptText="🔍 Buscar cliente..." style="-fx-background-color: #5B2A62; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #E3D9FC; -fx-background-radius: 6px; -fx-padding: 8px;" />
                <TableView fx:id="tableClientes" style="-fx-background-color: #040607; -fx-table-cell-border-color: #5B2A62;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Nombre" prefWidth="120" />
                        <TableColumn text="Documento" prefWidth="90" />
                        <TableColumn text="Teléfono" prefWidth="80" />
                        <TableColumn text="Correo" prefWidth="120" />
                        <TableColumn text="Edad" prefWidth="50" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>