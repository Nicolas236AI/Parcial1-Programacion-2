<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane style="-fx-background-color: #040607;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-pref-width: 250px;" spacing="15">
            <Label text="SmartGym" style="-fx-text-fill: #BF40FA; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" />
            <Label text="Panel de Control" style="-fx-text-fill: #E3D9FC; -fx-font-size: 12px; -fx-opacity: 0.8;" />
            <Separator style="-fx-background-color: #4928C2;" />
            <Button text=" Dashboard" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-font-weight: bold; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-background-radius: 8px;" />
            <Button text=" Gestión de Clientes" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Entrenadores" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Planes" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Servicios Adicionales" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Inscripciones" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Button text=" Reportes y Consultas" style="-fx-background-color: transparent; -fx-text-fill: #E3D9FC; -fx-alignment: CENTER_LEFT; -fx-pref-width: Infinity; -fx-padding: 10px; -fx-cursor: hand;" />
            <Region VBox.vgrow="ALWAYS" />
            <Label text="NIT: 900.123.456-7&#10;Armenia, Quindío" style="-fx-text-fill: #E3D9FC; -fx-font-size: 10px; -fx-opacity: 0.6;" />
        </VBox>
    </left>
    <center>
        <VBox style="-fx-background-color: #040607; -fx-padding: 30px;" spacing="25">
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px;">
                <VBox spacing="4">
                    <Label text="Bienvenido al Sistema SmartGym" style="-fx-text-fill: #BF40FA; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <Label text="Seleccione un módulo en la barra lateral o gestione las tarjetas rápidas." style="-fx-text-fill: #E3D9FC; -fx-font-size: 13px;" />
                </VBox>
            </HBox>
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" />
                    <ColumnConstraints percentWidth="33.33" />
                    <ColumnConstraints percentWidth="33.33" />
                </columnConstraints>
                <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 10px;" spacing="10" GridPane.columnIndex="0">
                    <Label text="Clientes Activos" style="-fx-text-fill: #E3D9FC; -fx-font-size: 14px;" />
                    <Label text="142" style="-fx-text-fill: #BF40FA; -fx-font-size: 28px; -fx-font-weight: bold;" />
                    <Button text="Gestionar Clientes" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" />
                </VBox>
                <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 10px;" spacing="10" GridPane.columnIndex="1">
                    <Label text="Entrenadores" style="-fx-text-fill: #E3D9FC; -fx-font-size: 14px;" />
                    <Label text="12" style="-fx-text-fill: #BF40FA; -fx-font-size: 28px; -fx-font-weight: bold;" />
                    <Button text="Ver Entrenadores" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" />
                </VBox>
                <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 10px;" spacing="10" GridPane.columnIndex="2">
                    <Label text="Inscripciones Mes" style="-fx-text-fill: #E3D9FC; -fx-font-size: 14px;" />
                    <Label text="38" style="-fx-text-fill: #BF40FA; -fx-font-size: 28px; -fx-font-weight: bold;" />
                    <Button text="Nueva Inscripción" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" />
                </VBox>
            </GridPane>
        </VBox>
    </center>
</BorderPane>