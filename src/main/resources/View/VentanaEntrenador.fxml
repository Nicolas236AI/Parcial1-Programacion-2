<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox spacing="20" style="-fx-background-color: #040607; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px; -fx-pref-width: 320px;" spacing="12">
        <Label text="Gestión de Entrenadores" style="-fx-text-fill: #BF40FA; -fx-font-size: 18px; -fx-font-weight: bold;" />
        <TextField promptText="Identificación" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField promptText="Nombre Completo" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField promptText="Especialidad" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField promptText="Teléfono" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TextField promptText="Correo Electrónico" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <DatePicker promptText="Fecha de Registro" style="-fx-pref-width: Infinity;" />
        <TextField promptText="Tarifa por Sesión" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <Region VBox.vgrow="ALWAYS" />
        <HBox spacing="15" alignment="CENTER">
            <Button text="Guardar" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 16px; -fx-cursor: hand;" />
            <Button text="Actualizar" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 16px; -fx-cursor: hand;" />
        </HBox>
    </VBox>
    <VBox style="-fx-background-color: #040607;" spacing="12" HBox.hgrow="ALWAYS">
        <TextField promptText="🔍 Buscar entrenador..." style="-fx-background-color: #5B2A62; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #E3D9FC; -fx-background-radius: 6px; -fx-padding: 8px;" />
        <TableView fx:id="tableEntrenadores" style="-fx-background-color: #040607; -fx-table-cell-border-color: #5B2A62;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Identificación" prefWidth="100" />
                <TableColumn text="Nombre" prefWidth="120" />
                <TableColumn text="Especialidad" prefWidth="100" />
                <TableColumn text="Tarifa Sesión" prefWidth="90" />
            </columns>
        </TableView>
    </VBox>
</HBox>