<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox spacing="15" style="-fx-background-color: #040607; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.ViewController.PlanViewController">


    <VBox spacing="12" style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px;">
        <Label text="Gestión de Planes de Entrenamiento" style="-fx-text-fill: #BF40FA; -fx-font-size: 18px; -fx-font-weight: bold;" />

        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="34"/>
            </columnConstraints>
            <children>
                <ComboBox fx:id="comboTipoPlan" promptText="Tipo Plan" maxWidth="1.7976931348623157E308" style="-fx-background-color: #040607; -fx-padding: 4px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCodigo" promptText="Código" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" promptText="Nombre del Plan" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                <TextField fx:id="txtDuracion" promptText="Duración (Meses)" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtValorMensual" promptText="Valor Mensual" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <ComboBox fx:id="comboEstado" promptText="Estado" maxWidth="1.7976931348623157E308" style="-fx-background-color: #040607; -fx-padding: 4px;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            </children>
        </GridPane>


        <HBox spacing="10" alignment="CENTER">
            <Button text="Crear Plan" onAction="#onCrearPlan" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" />
            <Button text="Modificar" onAction="#onModificarPlan" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" />
            <Button text="Eliminar" onAction="#onEliminarPlan" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" />
        </HBox>
    </VBox>


    <TableView fx:id="tablePlanes" style="-fx-background-color: #040607; -fx-table-cell-border-color: #5B2A62;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="100" />
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180" />
            <TableColumn fx:id="colDuracion" text="Duración" prefWidth="100" />
            <TableColumn fx:id="colValorMensual" text="Valor Mensual" prefWidth="120" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>


    <HBox alignment="CENTER" style="-fx-background-color: #5B2A62; -fx-padding: 15px; -fx-background-radius: 12px;">
        <Button text="Clonar Plan Seleccionado" onAction="#onClonarPlan" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 6px; -fx-padding: 10px 24px; -fx-cursor: hand;" />
    </HBox>
</VBox>