<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.*?>
<?import java.lang.*?>

<BorderPane style="-fx-background-color: #040607; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px;" spacing="12">
            <Label text="Gestión de Planes de Entrenamiento" style="-fx-text-fill: #BF40FA; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <GridPane hgap="12" vgap="12">
                <ComboBox promptText="Tipo Plan" style="-fx-background-color: #040607;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Básico" />
                            <String fx:value="Premium" />
                            <String fx:value="Personalizado" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <TextField promptText="Código" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField promptText="Nombre del Plan" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField promptText="Duración (Meses)" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField promptText="Valor Mensual" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <ComboBox promptText="Estado" style="-fx-background-color: #040607;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="ACTIVO" />
                            <String fx:value="SUSPENDIDO" />
                            <String fx:value="FINALIZADO" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </GridPane>
        </VBox>
    </top>
    <center>
        <VBox style="-fx-padding: 15px 0px 15px 0px; -fx-background-color: #040607;">
            <TableView fx:id="tablePlanes" style="-fx-background-color: #040607; -fx-table-cell-border-color: #5B2A62;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Código" prefWidth="90" />
                    <TableColumn text="Nombre" prefWidth="140" />
                    <TableColumn text="Duración" prefWidth="80" />
                    <TableColumn text="Valor Mensual" prefWidth="110" />
                    <TableColumn text="Estado" prefWidth="90" />
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox style="-fx-background-color: #5B2A62; -fx-padding: 15px; -fx-background-radius: 12px;" alignment="CENTER">
            <Button text="Clonar Plan Seleccionado" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand;" />
        </HBox>
    </bottom>
</BorderPane>