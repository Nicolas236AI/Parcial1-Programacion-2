<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.*?>
<?import java.lang.*?>

<BorderPane style="-fx-background-color: #040607; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px;" spacing="12">
            <Label text="Servicios Adicionales (Patrón Factory)" style="-fx-text-fill: #BF40FA; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <ComboBox promptText="Seleccionar Fábrica de Servicio..." style="-fx-background-color: #040607; -fx-pref-width: 260px;">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Valoración Física" />
                        <String fx:value="Asesoría Nutricional" />
                        <String fx:value="Entrenamiento Personalizado" />
                        <String fx:value="Clases Especiales" />
                    </FXCollections>
                </items>
            </ComboBox>
            <HBox spacing="12">
                <TextField promptText="Código" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93;" />
                <TextField promptText="Nombre del Servicio" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93;" />
                <TextField promptText="Precio" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93;" />
                <CheckBox text="Disponible" style="-fx-text-fill: #E3D9FC; -fx-padding: 5px;" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox style="-fx-padding: 15px 0px 0px 0px; -fx-background-color: #040607;">
            <TableView fx:id="tableServicios" style="-fx-background-color: #040607; -fx-table-cell-border-color: #5B2A62;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Código" prefWidth="100" />
                    <TableColumn text="Nombre del Servicio" prefWidth="180" />
                    <TableColumn text="Precio" prefWidth="110" />
                    <TableColumn text="Disponibilidad" prefWidth="110" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>