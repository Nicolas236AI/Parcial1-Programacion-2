<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="15" style="-fx-background-color: #040607; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.ViewController.ServicioAdicionalViewController">


    <VBox spacing="12" style="-fx-background-color: #5B2A62; -fx-padding: 20px; -fx-background-radius: 12px;">
        <Label text="Gestión de Servicios Adicionales" style="-fx-text-fill: #BF40FA; -fx-font-size: 18px; -fx-font-weight: bold;" />

        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="34"/>
            </columnConstraints>
            <children>
                <TextField fx:id="txtCodigo" promptText="Código" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" promptText="Nombre del Servicio" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="txtPrecio" promptText="Precio" style="-fx-background-color: #040607; -fx-text-fill: #E3D9FC; -fx-prompt-text-fill: #8a7c93; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            </children>
        </GridPane>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Agregar Servicio" onAction="#onAgregarServicio" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" />
            <Button text="Modificar" onAction="#onModificarServicio" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" />
            <Button text="Eliminar" onAction="#onEliminarServicio" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" style="-fx-background-color: #4928C2; -fx-text-fill: #E3D9FC; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" />
        </HBox>
    </VBox>


    <TableView fx:id="tableServicios" style="-fx-background-color: #040607;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="120" />
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250" />
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>